{
  "name": "pdf-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A full-featured, client-side PDF editor for the web",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit false --pretty",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/pdf-editor/selftest.mjs --external:canvas --log-level=error && node node_modules/.cache/pdf-editor/selftest.mjs",
    "sample": "esbuild scripts/make-sample.ts --bundle --platform=node --format=esm --target=node20 --outfile=node_modules/.cache/pdf-editor/make-sample.mjs --log-level=error && node node_modules/.cache/pdf-editor/make-sample.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@fontsource/lora": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
